{
 "job": {"type": "object", "required": ["name", "date", "day", "script", "shots", "music"],
   "properties": {"name": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "date": {"type": "string", "pattern": "^20\\d\\d-\\d\\d-\\d\\d$"},
     "day": {"type": "integer"}, "script": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 3}},
     "shots": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["url"], "properties": {"url": {"type": "string", "pattern": "^https://"}, "start": {"type": "number", "minimum": 0}}}}},
     "music": {"type": "object", "required": ["url"]}, "tiktok_lines": {"type": "array", "items": {"type": "integer", "minimum": 0}}}},
 "short_result": {"type": "object", "required": ["ok", "name"], "properties": {"ok": {"type": "boolean"}, "name": {"type": "string"}, "attempts": {"type": "integer"},
     "urls": {"type": "object"}, "error": {"type": ["string", "null"]}}},
 "clipjob": {"type": "object", "required": ["name", "source"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9_-]+$"}, "source": {"type": "string", "pattern": "^https?://"},
     "layout": {"enum": ["framed", "full", "native", "split"]}, "min_len": {"type": "number"},
     "clips": {"type": "array", "items": {"type": "object", "required": ["id", "a", "b"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$"},
       "a": {"type": "number", "minimum": 0}, "b": {"type": "number"}, "title": {"type": "string"}, "caption": {"type": "string"},
       "layout": {"enum": ["framed", "full", "native", "split"]}}, "anyOf": [{"required": ["title"]}, {"required": ["caption"]}]}}}},
 "clip_result": {"type": "object", "required": ["ok", "name", "sig", "attempts", "clips"], "properties": {"ok": {"type": "boolean"}, "attempts": {"type": "integer"},
     "clips": {"type": "array", "items": {"type": "object", "required": ["id", "ok"]}}}},
 "countdown_plan": {"type": "object", "required": ["release_date", "entries"], "properties": {"release_date": {"type": "string"},
     "entries": {"type": "array", "items": {"type": "object", "required": ["date", "day", "script"]}}}},
 "kampagnen": {"type": "object", "required": ["joined"], "properties": {"joined": {"type": "array", "items": {"type": "object", "required": ["match", "account"]}}, "min_rate": {"type": "number"}, "min_left": {"type": "number"}}},
 "stats_plan": {"type": "object", "required": ["accounts", "campaigns"], "properties": {"accounts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name"]}},
     "campaigns": {"type": "array", "items": {"type": "object", "required": ["name", "match"], "properties": {"match": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}, "min_views": {"type": ["integer", "null"]}}}}}},
 "trendscout": {"type": "object", "required": ["reddit", "kick", "news"], "properties": {"news": {"type": "object", "required": ["feeds", "words"]}}},
 "reflab": {"type": "object", "required": ["accounts"]},
 "camtest": {"type": "object", "required": ["channels"]},
 "gta6_launch": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
 "stats_latest": {"type": "object", "required": ["updated", "accounts", "posts", "problems"], "properties": {"posts": {"type": "array", "items": {"type": "object", "required": ["platform", "id", "url", "account", "views"]}}}},
 "feed_latest": {"type": "object", "required": ["at", "errors", "items"]},
 "waechter": {"type": "object", "required": ["seit", "ignorieren", "kampagnen"]},
 "eingereicht": {"type": "object", "required": ["seit", "eingereicht"], "properties": {"eingereicht": {"type": "array", "items": {"type": "string"}}, "nicht_noetig": {"type": "array", "items": {"type": "string"}}, "slots": {"type": "array", "items": {"type": "string", "pattern": "^[^|]+\\|[^|]+\\|\\d{4}-\\d{2}-\\d{2}\\|\\d{2}:\\d{2}$"}}, "posts": {"type": "array", "items": {"type": "string"}}}},
 "postplan": {"type": "object", "required": ["slots"], "properties": {"slots": {"type": "array", "items": {"type": "object", "required": ["datum", "zeit", "konto", "kampagne", "clip"], "properties": {"datum": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "zeit": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"}, "plattformen": {"type": "array", "items": {"enum": ["tiktok", "youtube", "instagram"]}}}}}}}
}
